importer io
importer json
importer os
importer shutil
importer sys
importer importlib
depuis pathlib importer Path

soit RACINE = Path(__file__).parent.parent
soit SOURCE_MULTI = RACINE / "src" / "main.multi"
soit DOSSIER_PUBLIC = RACINE / "public"
DOSSIER_PUBLIC.mkdir(parents=Vrai, exist_ok=Vrai)

soit SORTIE_MULTI = DOSSIER_PUBLIC / "main.multi"
soit SORTIE_MULTI_BUNDLE = DOSSIER_PUBLIC / "main_wasm_bundle.multi"
soit SORTIE_PY = DOSSIER_PUBLIC / "mandelbrot_transpiled.py"
soit SORTIE_BENCH = DOSSIER_PUBLIC / "benchmark.json"
soit SORTIE_WASM_RS = DOSSIER_PUBLIC / "wasm_intermediate.rs"
soit SORTIE_WAT = DOSSIER_PUBLIC / "main.wat"
soit SORTIE_WASM = DOSSIER_PUBLIC / "mandelbrot.wasm"
soit SORTIE_MANIFEST = DOSSIER_PUBLIC / "wasm_manifest.json"

# Module « Atelier L-système » — UI authored en multilingual via le pont DOM.
# Compilé vers son propre WASM (importe ml_dom_*), chargé séparément du noyau
# de calcul mandelbrot.wasm. Première tranche de la migration Meta.
soit SOURCE_ATELIER = RACINE / "src" / "atelier_lsysteme.multi"
soit SORTIE_ATELIER_WAT = DOSSIER_PUBLIC / "atelier_lsysteme.wat"
soit SORTIE_ATELIER_WASM = DOSSIER_PUBLIC / "atelier_lsysteme.wasm"
soit SORTIE_ATELIER_SHIM = DOSSIER_PUBLIC / "js" / "atelier_lsysteme_shim.js"

soit TAILLE_BENCH_GRILLE = 200
soit ITER_BENCH_MAX = 100
soit SEPARATEUR = "=" * 62
soit MODULES_WASM = ["fractales_escape", "fractales_dynamique", "fractales_variantes", "fractales_ifs", "fractales_lsystem", "fractales_magnetiques", "fractales_export", "fractales_navigation", "fractales_classes_compat", "fractales_lisse", "fractales_de", "fractales_deep_zoom", "fractales_orbitrap", "fractales_formule", "fractales_transforms", "fractales_orbite", "fractales_partage", "fractales_hasard", "fractales_landmark", "fractales_simd", "fractales_volumetrique", "fractales_couleur"]

déf ajouter_depot_multilingual_au_chemin():
    soit chemin_dev = os.environ.get("MULTILINGUAL_DEV_PATH", "").strip()
    si non chemin_dev:
        retour

    soit candidat = Path(chemin_dev).expanduser()
    si non candidat.is_absolute():
        candidat = (RACINE / candidat).resolve()
    si non (candidat / "multilingualprogramming" / "__init__.py").exists():
        lever RuntimeError(f"MULTILINGUAL_DEV_PATH ne pointe pas vers un depot multilingual valide: {candidat}")
    si non (str(candidat) dans sys.path):
        sys.path.insert(0, str(candidat))

déf transpiler_strict(source):
    ajouter_depot_multilingual_au_chemin()
    soit ProgramExecutor = importlib.import_module("multilingualprogramming").ProgramExecutor
    soit executeur = ProgramExecutor(language="fr")
    soit code_python = executeur.transpile(source)
    si non code_python ou non code_python.strip():
        lever RuntimeError("Transpilation multilingual vide.")
    retour code_python

déf analyser_programme(source):
    ajouter_depot_multilingual_au_chemin()
    soit lexer_module = importlib.import_module("multilingualprogramming.lexer.lexer")
    soit parser_module = importlib.import_module("multilingualprogramming.parser.parser")
    soit Lexer = lexer_module.Lexer
    soit Parser = parser_module.Parser
    soit lexeur = Lexer(source, language="fr")
    soit jetons = lexeur.tokenize()
    soit analyseur = Parser(jetons, source_language=(lexeur.language ou "fr"))
    retour analyseur.parse()

déf emettre_intermediaire_wasm_si_disponible(source):
    soit ok = Faux
    soit detail_erreur = None
    essayer:
        soit wasm_generator_module = importlib.import_module("multilingualprogramming.codegen.wasm_generator")
        soit WasmCodeGenerator = wasm_generator_module.WasmCodeGenerator
        soit programme = analyser_programme(source)
        soit code_rust = WasmCodeGenerator().generate(programme)
        SORTIE_WASM_RS.write_text(code_rust, encoding="utf-8")
        ok = Vrai
    sauf Exception comme erreur:
        detail_erreur = str(erreur)
    retour (ok, detail_erreur)

déf calculer_attribution_modules(modules_wasm):
    # Scanne chaque `src/<module>.multi` pour récupérer le nom du module
    # d'origine de chaque `déf NAME(`. Utilisé pour attribuer
    # `FunctionDef.source_module` après que le bundle source a été parsé en
    # un seul programme — sans recourir à un parse-par-fichier qui casserait
    # le pipeline existant.
    soit attribution = {}
    pour nom_module dans modules_wasm:
        soit chemin = RACINE / "src" / f"{nom_module}.multi"
        si non chemin.exists():
            continuer
        soit texte = chemin.read_text(encoding="utf-8")
        pour ligne dans texte.splitlines():
            soit brut = ligne.strip()
            si non brut.startswith("déf "):
                continuer
            soit reste = brut[4:]
            soit i = 0
            tantque i < longueur(reste) et reste[i] != "(":
                i = i + 1
            soit nom = reste[:i].strip()
            si nom:
                attribution[nom] = nom_module
    retour attribution

déf attribuer_modules_au_programme(programme, attribution):
    # Walk `programme.body` ; pour chaque FunctionDef dont le nom est dans
    # l'attribution, fixe `source_module` (cf. multilingual B6 manifeste).
    pour noeud dans programme.body:
        si non hasattr(noeud, "name"):
            continuer
        si non hasattr(noeud, "params"):
            continuer
        si non hasattr(noeud, "body"):
            continuer
        si non hasattr(noeud, "source_module"):
            continuer
        soit nom_brut = noeud.name
        soit nom_str = nom_brut si isinstance(nom_brut, str) sinon getattr(nom_brut, "name", str(nom_brut))
        si nom_str dans attribution:
            noeud.source_module = attribution[nom_str]

déf generer_wat_et_wasm_strict(source, attribution=None):
    ajouter_depot_multilingual_au_chemin()
    soit wat_generator_module = importlib.import_module("multilingualprogramming.codegen.wat_generator")
    soit WATCodeGenerator = wat_generator_module.WATCodeGenerator
    soit wasmtime = importlib.import_module("wasmtime")

    soit programme = analyser_programme(source)
    si attribution:
        attribuer_modules_au_programme(programme, attribution)
    soit generateur = WATCodeGenerator()
    soit texte_wat = generateur.generate(programme)
    soit octets_wasm = wasmtime.wat2wasm(texte_wat)
    soit manifeste = generateur.generate_abi_manifest(programme)
    retour (texte_wat, octets_wasm, manifeste)

déf construire_atelier_lsysteme():
    # Compile src/atelier_lsysteme.multi vers public/atelier_lsysteme.wasm et
    # émet le shim hôte JS généré (WASI + pont DOM) vers public/js/.
    ajouter_depot_multilingual_au_chemin()
    si non SOURCE_ATELIER.exists():
        lever RuntimeError(f"Source atelier introuvable: {SOURCE_ATELIER}")
    soit wat_generator_module = importlib.import_module("multilingualprogramming.codegen.wat_generator")
    soit WATCodeGenerator = wat_generator_module.WATCodeGenerator
    soit wasmtime = importlib.import_module("wasmtime")

    soit source = SOURCE_ATELIER.read_text(encoding="utf-8")
    soit programme = analyser_programme(source)
    soit texte_wat = WATCodeGenerator().generate(programme)
    verifier_wat_strict(texte_wat)
    soit octets_wasm = wasmtime.wat2wasm(texte_wat)
    SORTIE_ATELIER_WAT.write_text(texte_wat, encoding="utf-8")
    SORTIE_ATELIER_WASM.write_bytes(octets_wasm)
    valider_exports_wasm(octets_wasm, ["tracer_lsysteme"])

    # Shim hôte JS généré depuis le manifeste ABI (le JS n'est que de la colle).
    soit manifeste = WATCodeGenerator().generate_abi_manifest(programme)
    soit shim = WATCodeGenerator().generate_js_host_shim(manifeste)
    SORTIE_ATELIER_SHIM.parent.mkdir(parents=Vrai, exist_ok=Vrai)
    SORTIE_ATELIER_SHIM.write_text(shim, encoding="utf-8")
    retour octets_wasm

déf verifier_wat_strict(texte_wat):
    si ("unsupported call" dans texte_wat):
        lever RuntimeError("WAT non strict: 'unsupported call' detecte.")
    si ("unresolved:" dans texte_wat):
        lever RuntimeError("WAT non strict: 'unresolved' detecte.")

déf valider_exports_wasm(octets_wasm, exports_requises):
    soit wasmtime = importlib.import_module("wasmtime")
    soit moteur = wasmtime.Engine()
    soit magasin = wasmtime.Store(moteur)
    soit module = wasmtime.Module(moteur, octets_wasm)
    soit imports = []
    pour imp dans module.imports:
        si isinstance(imp.type, wasmtime.FuncType):
            soit nb_resultats = longueur(imp.type.results)
            si nb_resultats == 0:
                déf _stub_no_result(*_args):
                    retour None
                imports.append(wasmtime.Func(magasin, imp.type, _stub_no_result))
            sinonsi nb_resultats == 1:
                déf _stub_one_result(*_args):
                    retour 0
                imports.append(wasmtime.Func(magasin, imp.type, _stub_one_result))
            sinon:
                déf _stub_multi_result(*_args):
                    retour tuple(0 pour _ dans intervalle(nb_resultats))
                imports.append(wasmtime.Func(magasin, imp.type, _stub_multi_result))
        sinon:
            lever RuntimeError(f"Type d'import non supporte pour validation: {imp.type}")

    soit instance = wasmtime.Instance(magasin, module, imports)
    soit exports = instance.exports(magasin)
    soit exports_manquantes = [nom pour nom dans exports_requises si non (nom dans exports)]
    si exports_manquantes:
        lever RuntimeError(f"Exports WASM manquants: {exports_manquantes}")

déf copier_sources_modules():
    # Copie chaque module source vers public/ et le transpile en Python individuel.
    # Permet l'affichage contextuel dans la barre latérale (un fichier par fractale).
    pour nom_module dans MODULES_WASM:
        soit chemin_src = RACINE / "src" / f"{nom_module}.multi"
        si non chemin_src.exists():
            continuer
        shutil.copy(chemin_src, DOSSIER_PUBLIC / f"{nom_module}.multi")
        essayer:
            soit source_mod = chemin_src.read_text(encoding="utf-8")
            soit code_py_mod = transpiler_strict(source_mod)
            (DOSSIER_PUBLIC / f"{nom_module}.py").write_text(code_py_mod, encoding="utf-8")
            afficher(f"    OK {nom_module}.multi -> {nom_module}.py")
        sauf Exception comme err:
            afficher(f"    Avertissement ({nom_module}): {err}")
    # Module OOP : transpilation Python uniquement (classes non supportees en WAT)
    soit chemin_classes = RACINE / "src" / "fractales_classes.multi"
    si chemin_classes.exists():
        shutil.copy(chemin_classes, DOSSIER_PUBLIC / "fractales_classes.multi")
        essayer:
            soit source_cls = chemin_classes.read_text(encoding="utf-8")
            soit code_py_cls = transpiler_strict(source_cls)
            (DOSSIER_PUBLIC / "fractales_classes.py").write_text(code_py_cls, encoding="utf-8")
            afficher(f"    OK fractales_classes.multi -> fractales_classes.py")
        sauf Exception comme err:
            afficher(f"    Avertissement (fractales_classes): {err}")

déf construire_source_wasm_modulaire():
    soit morceaux = ["# Bundle WASM genere automatiquement depuis src/*.multi", "importer math", ""]
    pour nom_module dans MODULES_WASM:
        soit chemin = RACINE / "src" / f"{nom_module}.multi"
        si non chemin.exists():
            lever RuntimeError(f"Module introuvable pour bundle WASM: {chemin}")
        soit texte = chemin.read_text(encoding="utf-8")
        soit lignes_filtrees = []
        pour ligne dans texte.splitlines():
            soit brut = ligne.strip()
            si brut.startswith("importer fractales_"):
                continuer
            si brut.startswith("depuis fractales_"):
                continuer
            si brut == "importer math":
                continuer
            lignes_filtrees.append(ligne)
        morceaux.append(f"# --- module: {nom_module} ---")
        morceaux.append(chr(10).join(lignes_filtrees).strip())
        morceaux.append("")
    retour chr(10).join(morceaux).strip() + chr(10)

déf main():
    si sys.stdout.encoding et non (sys.stdout.encoding.lower() dans ("utf-8", "utf8")):
        sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
    si sys.stderr.encoding et non (sys.stderr.encoding.lower() dans ("utf-8", "utf8")):
        sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding="utf-8", errors="replace")

    afficher(SEPARATEUR)
    afficher("  Explorateur de Fractales -- Build strict multilingual")
    afficher(SEPARATEUR)

    afficher("")
    afficher(f"[1] Lecture de {SOURCE_MULTI.relative_to(RACINE)}")
    si non SOURCE_MULTI.exists():
        lever RuntimeError(f"Fichier source introuvable: {SOURCE_MULTI}")
    soit source_humaine = SOURCE_MULTI.read_text(encoding="utf-8")
    afficher(f"    {longueur(source_humaine)} caracteres, {source_humaine.count(chr(10))} lignes")

    afficher("")
    afficher(f"[2] Copie vers {SORTIE_MULTI.relative_to(RACINE)}")
    shutil.copy(SOURCE_MULTI, SORTIE_MULTI)
    afficher("    Copie.")
    soit source_wasm = construire_source_wasm_modulaire()
    SORTIE_MULTI_BUNDLE.write_text(source_wasm, encoding="utf-8")
    afficher(f"    Bundle WASM ecrit: {SORTIE_MULTI_BUNDLE.relative_to(RACINE)}")

    si SORTIE_WASM.exists():
        SORTIE_WASM.unlink()
        afficher(f"    Ancien artefact supprime: {SORTIE_WASM.relative_to(RACINE)}")

    afficher("")
    afficher("[2b] Copie et transpilation individuelle des modules (affichage contextuel)")
    copier_sources_modules()

    afficher("")
    afficher("[3] Transpilation multilingual -> Python (strict)")
    soit code_python = transpiler_strict(source_wasm)
    SORTIE_PY.write_text(code_python, encoding="utf-8")
    afficher(f"    Ecrit dans {SORTIE_PY.relative_to(RACINE)}")
    afficher("    Apercu :")
    pour ligne dans code_python.splitlines()[:12]:
        afficher(f"      {ligne}")

    afficher("")
    afficher("[4] Generation WASM (backends officiels multilingual)")
    soit intermediaire_wasm_disponible, erreur_wasm = emettre_intermediaire_wasm_si_disponible(source_wasm)
    si intermediaire_wasm_disponible:
        afficher(f"    Rust intermediaire ecrit: {SORTIE_WASM_RS.relative_to(RACINE)}")
    sinon:
        afficher("    Rust intermediaire indisponible.")
        si erreur_wasm:
            afficher(f"    Detail: {erreur_wasm}")

    soit attribution = calculer_attribution_modules(MODULES_WASM)
    soit texte_wat, octets_wasm, manifeste = generer_wat_et_wasm_strict(source_wasm, attribution=attribution)
    verifier_wat_strict(texte_wat)
    SORTIE_WAT.write_text(texte_wat, encoding="utf-8")
    SORTIE_WASM.write_bytes(octets_wasm)
    SORTIE_MANIFEST.write_text(json.dumps(manifeste, indent=2, ensure_ascii=Faux), encoding="utf-8")
    afficher(f"    WAT ecrit : {SORTIE_WAT.relative_to(RACINE)}")
    afficher(f"    WASM ecrit: {SORTIE_WASM.relative_to(RACINE)} ({longueur(octets_wasm):,} octets)")
    afficher(f"    Manifest  : {SORTIE_MANIFEST.relative_to(RACINE)} ({longueur(manifeste.get('modules', {}))} modules attribues)")

    soit exports_transforms = ["transforme_log_polaire", "transforme_inversion", "transforme_pli_xy", "transforme_cayley", "transforme_joukowski"]
    soit exports_orbite = ["orbite_mandelbrot_famille", "orbite_newton", "orbite_phoenix"]
    soit exports_partage = ["valider_centre", "valider_pixelsize", "valider_max_iter", "valider_rotation", "valider_etat_complet", "formatter_fixe", "formatter_exponentiel_8", "formatter_exponentiel_9"]
    soit exports_hasard = ["hash_fnv32_seed", "prochain_hash_mulberry32"]
    soit exports_landmark = ["detecter_periode_mandelbrot", "affiner_nucleus", "distance_estimation_mandelbrot"]
    soit exports_simd = ["mandelbrot_simd_pair"]
    soit exports_couleur = ["couleur_thermique", "couleur_relief"]

    soit exports_requises = ["mandelbrot", "julia", "burning_ship", "tricorn", "multibrot", "celtic", "buffalo", "perpendicular_burning_ship", "heart", "perpendicular_mandelbrot", "perpendicular_celtic", "duck", "buddhabrot", "burning_julia", "biomorphe", "formule_cosinus_c", "formule_biomorphe", "formule_tricorne", "formule_perturbee_canonique", "formule_rationnelle_canonique", "formule_exponentielle_canonique", "formule_tangente_canonique", "formule_norme_canonique", "newton", "phoenix", "lyapunov", "lyapunov_multisequence", "bassin_newton_generalise", "orbitale_de_nova", "collatz_complexe", "attracteur_de_clifford", "attracteur_de_clifford_etape", "attracteur_de_peter_de_jong", "attracteur_de_peter_de_jong_etape", "attracteur_ikeda", "attracteur_ikeda_etape", "attracteur_de_henon", "attracteur_de_henon_etape", "lorenz_attractor", "lorenz_attractor_etape", "projeter_lorenz_x", "projeter_lorenz_y", "rossler_attractor", "rossler_attractor_etape", "projeter_rossler_x", "projeter_rossler_y", "aizawa_attractor", "aizawa_attractor_etape", "projeter_aizawa_x", "projeter_aizawa_y", "sprott_attractor", "sprott_attractor_etape", "projeter_sprott_x", "projeter_sprott_y", "feigenbaum_tree", "duffing_attractor", "duffing_attractor_etape", "barnsley", "barnsley_etape", "sierpinski", "sierpinski_etape", "tapis_sierpinski", "tapis_sierpinski_etape", "menger_sponge", "menger_etape", "mandelbulb", "mandelbulb_etape", "tetraedre_sierpinski", "tetraedre_etape", "julia_quaternion", "julia_quaternion_etape", "mandelbox", "mandelbox_etape", "vicsek_fractal", "vicsek_etape", "lichtenberg_figures", "koch", "dragon_heighway", "courbe_levy_c", "gosper_curve", "cantor_set", "triangle_de_cercles_recursifs", "apollonian_gasket", "t_square_fractal", "h_fractal", "hilbert_curve", "peano_curve", "arbre_pythagore", "magnet1", "magnet2", "magnet3", "lambda_fractale", "lambda_cubique", "magnet_cosinus", "magnet_sinus", "nova_magnetique", "mandelbrot_lisse", "julia_lisse", "burning_ship_lisse", "tricorn_lisse", "mandelbrot_de", "julia_de", "mandelbrot_piege_cercle", "mandelbrot_piege_croix", "mandelbrot_piege_ligne", "julia_piege_cercle", "interpoler_lineaire", "interpoler_logarithmique", "ajuster_iterations_export", "easer_cubique", "interpoler_pixelsize_nav", "interpoler_angle_nav", "mandelbrot_classe", "evaluer_affine_x", "evaluer_affine_y", "choisir_transformee_ifs"]
    valider_exports_wasm(octets_wasm, exports_requises)
    afficher(f"    Exports valides: {', '.join(exports_requises)}")
    valider_exports_wasm(octets_wasm, exports_transforms)
    afficher(f"    Exports transforms: {', '.join(exports_transforms)}")
    valider_exports_wasm(octets_wasm, exports_orbite)
    afficher(f"    Exports orbite: {', '.join(exports_orbite)}")
    valider_exports_wasm(octets_wasm, exports_partage)
    afficher(f"    Exports partage: {', '.join(exports_partage)}")
    valider_exports_wasm(octets_wasm, exports_hasard)
    afficher(f"    Exports hasard: {', '.join(exports_hasard)}")
    valider_exports_wasm(octets_wasm, exports_landmark)
    afficher(f"    Exports landmark: {', '.join(exports_landmark)}")
    valider_exports_wasm(octets_wasm, exports_simd)
    afficher(f"    Exports simd: {', '.join(exports_simd)}")
    valider_exports_wasm(octets_wasm, exports_couleur)
    afficher(f"    Exports couleur: {', '.join(exports_couleur)}")

    afficher("")
    afficher("[4b] Atelier L-systeme (UI multilingual via pont DOM)")
    soit octets_atelier = construire_atelier_lsysteme()
    afficher(f"    WAT  ecrit: {SORTIE_ATELIER_WAT.relative_to(RACINE)}")
    afficher(f"    WASM ecrit: {SORTIE_ATELIER_WASM.relative_to(RACINE)} ({longueur(octets_atelier):,} octets)")
    afficher(f"    Shim ecrit: {SORTIE_ATELIER_SHIM.relative_to(RACINE)}")
    afficher("    Export valide: tracer_lsysteme")

    afficher("")
    afficher("[5] Benchmark")
    afficher("    Ignore dans ce pipeline strict (pas d'execution runtime hors compilation).")

    afficher("")
    afficher(f"[6] Ecriture de {SORTIE_BENCH.relative_to(RACINE)}")
    soit donnees_benchmark = {"python_ms": None, "wasm_ms": None, "speedup": None, "multibrot_python_ms": None, "multibrot_wasm_ms": None, "multibrot_speedup": None, "grid_size": TAILLE_BENCH_GRILLE, "max_iter": ITER_BENCH_MAX, "wasm_available": Vrai, "wasm_estimated": Faux, "wasm_pipeline": "multilingual_official_wat2wasm"}
    SORTIE_BENCH.write_text(json.dumps(donnees_benchmark, indent=2, ensure_ascii=Faux), encoding="utf-8")
    afficher(json.dumps(donnees_benchmark, indent=4, ensure_ascii=Faux))

    afficher("")
    afficher(SEPARATEUR)
    afficher("  OK Build strict multilingual termine.")
    afficher(f"    MULTI   : {SORTIE_MULTI.relative_to(RACINE)}")
    afficher(f"    MULTI+  : {SORTIE_MULTI_BUNDLE.relative_to(RACINE)}")
    afficher(f"    PY   : {SORTIE_PY.relative_to(RACINE)}")
    si intermediaire_wasm_disponible:
        afficher(f"    RS   : {SORTIE_WASM_RS.relative_to(RACINE)}")
    afficher(f"    WAT  : {SORTIE_WAT.relative_to(RACINE)}")
    afficher(f"    WASM : {SORTIE_WASM.relative_to(RACINE)}")
    afficher(f"    JSON : {SORTIE_BENCH.relative_to(RACINE)}")
    afficher(SEPARATEUR)
