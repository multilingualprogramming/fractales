# Atelier L-système — moteur de réécriture ET tortue, authored en multilingual.
#
# Tranche « Meta » : la grammaire L-système (réécriture simultanée de l'axiome)
# ET l'interprétation tortue (géométrie : cos/sin, branchement [ ], accumulation
# des sommets), jusqu'ici en JavaScript, vivent désormais en multilingual et sont
# compilées vers WebAssembly. Le module lit lui-même les champs du panneau via le
# pont DOM et écrit l'aperçu ; le JavaScript se réduit au shim généré plus le
# tracé canvas (préoccupation hôte) à partir des sommets renvoyés.
#
# Contraintes du backend WAT exploitées :
#   - les paramètres-chaîne ne portent pas leur longueur → tout vit dans une
#     seule routine avec des chaînes locales (lookup de règle inliné) ;
#   - `et` / `ou` ne court-circuitent pas → gardes imbriquées par `si` ;
#   - allocateur bump sans libération → l'hôte appelle __ml_reset avant chaque
#     appel ; matérialisation bornée par CAPACITE.
#
# Sortie : une liste pré-dimensionnée `sommets` dont l'élément [0] porte le
# nombre de sommets np, suivie de triplets (x, y, déplacer) — `déplacer` = 1.0
# pour un moveTo (début de sous-tracé), 0.0 pour un lineTo. L'hôte lit np puis
# 3*np valeurs et trace en mettant à l'échelle selon le canvas.

déf tracer_lsysteme(generations, angle_deg):
    soit CAPACITE = 8000        # longueur maximale matérialisée de la chaîne
    soit APERCU_MAX = 600       # caractères affichés dans l'aperçu
    soit MAXPTS = 8016          # capacité du tampon de sommets (>= CAPACITE + 16)
    soit MAXPILE = 4096         # profondeur max de la pile de branchement

    soit champ_axiome = dom_get("lsystem-axiom-input")
    soit champ_regles = dom_get("lsystem-rules-input")
    soit axiome = dom_value_str(champ_axiome)
    soit regles = dom_value_str(champ_regles)

    # ----- expansion de la grammaire (réécriture simultanée, bornée) -----
    soit seq = axiome
    soit nr = longueur(regles)
    soit g = 0
    tantque g < generations:
        soit suivant = ""
        soit i = 0
        soit nseq = longueur(seq)
        soit plein = 0
        tantque i < nseq:
            si plein == 0:
                soit c = seq[i]
                soit k = 0
                soit debut = 1
                soit prod = ""
                soit trouve = 0
                tantque k < nr:
                    si trouve == 0:
                        si debut == 1:
                            si regles[k] == c:
                                soit ok = 0
                                si k + 1 < nr:
                                    si regles[k + 1] == "=":
                                        ok = 1
                                si ok == 1:
                                    soit j = k + 2
                                    soit fin = nr
                                    soit ferme = 0
                                    soit jj = j
                                    tantque jj < nr:
                                        si ferme == 0:
                                            si regles[jj] == "\n":
                                                fin = jj
                                                ferme = 1
                                            si regles[jj] == ";":
                                                fin = jj
                                                ferme = 1
                                        jj = jj + 1
                                    prod = regles[j:fin]
                                    trouve = 1
                        si regles[k] == "\n":
                            debut = 1
                        sinon:
                            si regles[k] == ";":
                                debut = 1
                            sinon:
                                debut = 0
                    k = k + 1
                si trouve == 1:
                    suivant = suivant + prod
                sinon:
                    suivant = suivant + c
                si longueur(suivant) >= CAPACITE:
                    plein = 1
            i = i + 1
        seq = suivant
        g = g + 1

    soit n = longueur(seq)

    # ----- aperçu textuel (écrit dans le DOM par le module lui-même) -----
    soit borne = n
    si borne > APERCU_MAX:
        borne = APERCU_MAX
    soit apercu = seq[0:borne]
    soit cible = dom_get("lsystem-string-preview")
    dom_text(cible, apercu)

    # ----- interprétation tortue → sommets (x, y, déplacer) -----
    soit pas = angle_deg * 3.141592653589793 / 180.0
    soit sommets = [0.0] * (1 + 3 * MAXPTS)
    soit px = [0.0] * MAXPILE
    soit py = [0.0] * MAXPILE
    soit pa = [0.0] * MAXPILE
    soit pgn = [0.0] * MAXPILE
    soit sp = 0

    soit x = 0.0
    soit y = 0.0
    soit ang = 0.0
    soit signe = 1.0

    # point initial (moveTo)
    sommets[1] = x
    sommets[2] = y
    sommets[3] = 1.0
    soit np = 1

    soit t = 0
    tantque t < n:
        soit ch = seq[t]
        si ch == "F":
            x = x + math.cos(ang)
            y = y + math.sin(ang)
            si np < MAXPTS:
                sommets[1 + 3 * np] = x
                sommets[2 + 3 * np] = y
                sommets[3 + 3 * np] = 0.0
                np = np + 1
        si ch == "G":
            x = x + math.cos(ang)
            y = y + math.sin(ang)
            si np < MAXPTS:
                sommets[1 + 3 * np] = x
                sommets[2 + 3 * np] = y
                sommets[3 + 3 * np] = 0.0
                np = np + 1
        si ch == "f":
            x = x + math.cos(ang)
            y = y + math.sin(ang)
            si np < MAXPTS:
                sommets[1 + 3 * np] = x
                sommets[2 + 3 * np] = y
                sommets[3 + 3 * np] = 1.0
                np = np + 1
        si ch == "+":
            ang = ang + pas * signe
        si ch == "-":
            ang = ang - pas * signe
        si ch == "[":
            si sp < MAXPILE:
                px[sp] = x
                py[sp] = y
                pa[sp] = ang
                pgn[sp] = signe
                sp = sp + 1
        si ch == "]":
            si sp > 0:
                sp = sp - 1
                x = px[sp]
                y = py[sp]
                ang = pa[sp]
                signe = pgn[sp]
                si np < MAXPTS:
                    sommets[1 + 3 * np] = x
                    sommets[2 + 3 * np] = y
                    sommets[3 + 3 * np] = 1.0
                    np = np + 1
        si ch == "|":
            ang = ang + 3.141592653589793
        si ch == "!":
            signe = -signe
        t = t + 1

    sommets[0] = np
    retour sommets
