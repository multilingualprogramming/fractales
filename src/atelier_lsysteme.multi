# Atelier L-système — moteur de réécriture ET tortue, authored en multilingual.
#
# Tranche « Meta » : la grammaire L-système ET l'interprétation tortue vivent en
# multilingual et sont compilées vers WebAssembly. Deux entrées :
#   - tortue_lsysteme(axiome, regles, generations, angle_deg) : tortue pure, sans
#     DOM, prenant l'axiome et les règles comme PARAMÈTRES chaîne. Utilisée par le
#     rendu du canvas principal (proposition L-système déterministe).
#   - tracer_lsysteme(generations, angle_deg) : lit les champs du panneau via le
#     pont DOM, écrit l'aperçu texte, puis DÉLÈGUE à tortue_lsysteme. Utilisée par
#     l'aperçu de l'Atelier.
#
# Les paramètres chaîne traversent désormais la frontière d'appel (tampons à
# longueur préfixée : en-tête à ptr-4) — d'où le découpage en deux fonctions.
#
# La tortue utilise un parcours en PROFONDEUR explicite (pile de tâches
# (code, génération restante)) qui n'instancie jamais la chaîne complète :
# coût O(nombre de sommets), borné par MAXPTS — pas de coût O(n²) ni de plafond
# de matérialisation. Les symboles sont stockés comme codes d'octet (ord()).
#
# Contraintes du backend WAT : `et`/`ou` sans court-circuit (gardes imbriquées) ;
# allocateur bump réinitialisé par l'hôte (__ml_reset) avant chaque appel.
#
# Sortie : liste `sommets` ; [0] = nombre de sommets np, puis np quintuplets
# (x, y, déplacer, profondeur, angle). déplacer = 1.0 pour moveTo, 0.0 pour lineTo.

déf tortue_chemin_brut(chemin: chaîne, angle_deg):
    # Tortue qui interprète une chaîne DÉJÀ développée — pas de réécriture. Permet
    # aux grammaires stochastiques de garder leur expansion JS bit-pour-bit (RNG
    # FNV+mulberry32 non porté en WAT) tout en utilisant la tortue WASM. Même
    # logique « feuille » que `tortue_lsysteme` ; sortie : sommets stride-5.
    soit MAXPTS = 200000
    soit MAXPILE = 8192

    soit n = longueur(chemin)
    soit pas = angle_deg * 3.141592653589793 / 180.0
    soit sommets = [0.0] * (1 + 5 * MAXPTS)
    soit bx = [0.0] * MAXPILE
    soit by = [0.0] * MAXPILE
    soit ba = [0.0] * MAXPILE
    soit bsg = [0.0] * MAXPILE
    soit bpf = [0.0] * MAXPILE
    soit bsp = 0

    soit x = 0.0
    soit y = 0.0
    soit ang = 0.0
    soit signe = 1.0
    soit prof = 0.0

    # point initial (moveTo)
    sommets[1] = x
    sommets[2] = y
    sommets[3] = 1.0
    sommets[4] = 0.0
    sommets[5] = 0.0
    soit np = 1

    soit i = 0
    tantque i < n:
        soit code = ord(chemin[i])
        si code == 70:           # 'F'
            x = x + math.cos(ang)
            y = y + math.sin(ang)
            si np < MAXPTS:
                sommets[1 + 5 * np] = x
                sommets[2 + 5 * np] = y
                sommets[3 + 5 * np] = 0.0
                sommets[4 + 5 * np] = prof
                sommets[5 + 5 * np] = ang
                np = np + 1
        si code == 71:           # 'G'
            x = x + math.cos(ang)
            y = y + math.sin(ang)
            si np < MAXPTS:
                sommets[1 + 5 * np] = x
                sommets[2 + 5 * np] = y
                sommets[3 + 5 * np] = 0.0
                sommets[4 + 5 * np] = prof
                sommets[5 + 5 * np] = ang
                np = np + 1
        si code == 102:          # 'f'
            x = x + math.cos(ang)
            y = y + math.sin(ang)
            si np < MAXPTS:
                sommets[1 + 5 * np] = x
                sommets[2 + 5 * np] = y
                sommets[3 + 5 * np] = 1.0
                sommets[4 + 5 * np] = prof
                sommets[5 + 5 * np] = ang
                np = np + 1
        si code == 43:           # '+'
            ang = ang + pas * signe
        si code == 45:           # '-'
            ang = ang - pas * signe
        si code == 91:           # '['
            si bsp < MAXPILE:
                bx[bsp] = x
                by[bsp] = y
                ba[bsp] = ang
                bsg[bsp] = signe
                bpf[bsp] = prof
                bsp = bsp + 1
            prof = prof + 1.0
        si code == 93:           # ']'
            si bsp > 0:
                bsp = bsp - 1
                x = bx[bsp]
                y = by[bsp]
                ang = ba[bsp]
                signe = bsg[bsp]
                prof = bpf[bsp]
                si np < MAXPTS:
                    sommets[1 + 5 * np] = x
                    sommets[2 + 5 * np] = y
                    sommets[3 + 5 * np] = 1.0
                    sommets[4 + 5 * np] = prof
                    sommets[5 + 5 * np] = ang
                    np = np + 1
        si code == 124:          # '|'
            ang = ang + 3.141592653589793
        si code == 33:           # '!'
            signe = -signe
        i = i + 1

    sommets[0] = np
    retour sommets


déf tortue_lsysteme(axiome: chaîne, regles: chaîne, generations, angle_deg):
    soit MAXPTS = 200000         # capacité du tampon de sommets
    soit MAXTASK = 8192          # profondeur max de la pile de tâches DFS
    soit MAXPILE = 8192          # profondeur max de la pile de branchement [ ]

    soit nr = longueur(regles)
    soit naxe = longueur(axiome)

    soit pas = angle_deg * 3.141592653589793 / 180.0
    soit sommets = [0.0] * (1 + 5 * MAXPTS)
    soit ts_code = [0.0] * MAXTASK
    soit ts_dep = [0.0] * MAXTASK
    soit sp = 0
    soit bx = [0.0] * MAXPILE
    soit by = [0.0] * MAXPILE
    soit ba = [0.0] * MAXPILE
    soit bsg = [0.0] * MAXPILE
    soit bpf = [0.0] * MAXPILE
    soit bsp = 0

    soit x = 0.0
    soit y = 0.0
    soit ang = 0.0
    soit signe = 1.0
    soit prof = 0.0

    # point initial (moveTo)
    sommets[1] = x
    sommets[2] = y
    sommets[3] = 1.0
    sommets[4] = 0.0
    sommets[5] = 0.0
    soit np = 1

    # empiler l'axiome à l'envers (codes d'octet) à la profondeur de génération
    soit a = naxe - 1
    tantque a >= 0:
        si sp < MAXTASK:
            ts_code[sp] = ord(axiome[a])
            ts_dep[sp] = generations
            sp = sp + 1
        a = a - 1

    tantque sp > 0:
        si np >= MAXPTS:
            sp = 0
        sinon:
            sp = sp - 1
            soit code = ts_code[sp]
            soit dep = ts_dep[sp]

            # chercher une production (par octet) si dep > 0
            soit dispo = 0
            soit pj = 0
            soit pfin = 0
            si dep > 0:
                soit k = 0
                soit debut = 1
                soit trouve = 0
                tantque k < nr:
                    si trouve == 0:
                        si debut == 1:
                            si ord(regles[k]) == code:
                                soit ok = 0
                                si k + 1 < nr:
                                    si regles[k + 1] == "=":
                                        ok = 1
                                si ok == 1:
                                    soit j = k + 2
                                    soit fin = nr
                                    soit ferme = 0
                                    soit jj = j
                                    tantque jj < nr:
                                        si ferme == 0:
                                            si regles[jj] == "\n":
                                                fin = jj
                                                ferme = 1
                                            si regles[jj] == ";":
                                                fin = jj
                                                ferme = 1
                                        jj = jj + 1
                                    pj = j
                                    pfin = fin
                                    dispo = 1
                                    trouve = 1
                        si regles[k] == "\n":
                            debut = 1
                        sinon:
                            si regles[k] == ";":
                                debut = 1
                            sinon:
                                debut = 0
                    k = k + 1

            si dispo == 1:
                # empiler les caractères de la production à l'envers (dep - 1)
                soit m = pfin - 1
                tantque m >= pj:
                    si sp < MAXTASK:
                        ts_code[sp] = ord(regles[m])
                        ts_dep[sp] = dep - 1
                        sp = sp + 1
                    m = m - 1
            sinon:
                # feuille : interpréter la tortue pour ce code d'octet
                si code == 70:           # 'F'
                    x = x + math.cos(ang)
                    y = y + math.sin(ang)
                    si np < MAXPTS:
                        sommets[1 + 5 * np] = x
                        sommets[2 + 5 * np] = y
                        sommets[3 + 5 * np] = 0.0
                        sommets[4 + 5 * np] = prof
                        sommets[5 + 5 * np] = ang
                        np = np + 1
                si code == 71:           # 'G'
                    x = x + math.cos(ang)
                    y = y + math.sin(ang)
                    si np < MAXPTS:
                        sommets[1 + 5 * np] = x
                        sommets[2 + 5 * np] = y
                        sommets[3 + 5 * np] = 0.0
                        sommets[4 + 5 * np] = prof
                        sommets[5 + 5 * np] = ang
                        np = np + 1
                si code == 102:          # 'f'
                    x = x + math.cos(ang)
                    y = y + math.sin(ang)
                    si np < MAXPTS:
                        sommets[1 + 5 * np] = x
                        sommets[2 + 5 * np] = y
                        sommets[3 + 5 * np] = 1.0
                        sommets[4 + 5 * np] = prof
                        sommets[5 + 5 * np] = ang
                        np = np + 1
                si code == 43:           # '+'
                    ang = ang + pas * signe
                si code == 45:           # '-'
                    ang = ang - pas * signe
                si code == 91:           # '['
                    si bsp < MAXPILE:
                        bx[bsp] = x
                        by[bsp] = y
                        ba[bsp] = ang
                        bsg[bsp] = signe
                        bpf[bsp] = prof
                        bsp = bsp + 1
                    prof = prof + 1.0
                si code == 93:           # ']'
                    si bsp > 0:
                        bsp = bsp - 1
                        x = bx[bsp]
                        y = by[bsp]
                        ang = ba[bsp]
                        signe = bsg[bsp]
                        prof = bpf[bsp]
                        si np < MAXPTS:
                            sommets[1 + 5 * np] = x
                            sommets[2 + 5 * np] = y
                            sommets[3 + 5 * np] = 1.0
                            sommets[4 + 5 * np] = prof
                            sommets[5 + 5 * np] = ang
                            np = np + 1
                si code == 124:          # '|'
                    ang = ang + 3.141592653589793
                si code == 33:           # '!'
                    signe = -signe

    sommets[0] = np
    retour sommets


déf tracer_lsysteme(generations, angle_deg):
    soit CAP_TEXTE = 2000        # matérialisation bornée pour l'aperçu texte
    soit APERCU_MAX = 600        # caractères affichés

    soit champ_axiome = dom_get("lsystem-axiom-input")
    soit champ_regles = dom_get("lsystem-rules-input")
    soit axiome = dom_value_str(champ_axiome)
    soit regles = dom_value_str(champ_regles)
    soit nr = longueur(regles)

    # ---------- aperçu texte (expansion concaténée, bornée) ----------
    soit seq = axiome
    soit g = 0
    tantque g < generations:
        soit suivant = ""
        soit i = 0
        soit ns = longueur(seq)
        soit plein = 0
        tantque i < ns:
            si plein == 0:
                soit c = seq[i]
                soit k = 0
                soit debut = 1
                soit prod = ""
                soit trouve = 0
                tantque k < nr:
                    si trouve == 0:
                        si debut == 1:
                            si regles[k] == c:
                                soit ok = 0
                                si k + 1 < nr:
                                    si regles[k + 1] == "=":
                                        ok = 1
                                si ok == 1:
                                    soit j = k + 2
                                    soit fin = nr
                                    soit ferme = 0
                                    soit jj = j
                                    tantque jj < nr:
                                        si ferme == 0:
                                            si regles[jj] == "\n":
                                                fin = jj
                                                ferme = 1
                                            si regles[jj] == ";":
                                                fin = jj
                                                ferme = 1
                                        jj = jj + 1
                                    prod = regles[j:fin]
                                    trouve = 1
                        si regles[k] == "\n":
                            debut = 1
                        sinon:
                            si regles[k] == ";":
                                debut = 1
                            sinon:
                                debut = 0
                    k = k + 1
                si trouve == 1:
                    suivant = suivant + prod
                sinon:
                    suivant = suivant + c
                si longueur(suivant) >= CAP_TEXTE:
                    plein = 1
            i = i + 1
        seq = suivant
        g = g + 1

    soit borne = longueur(seq)
    si borne > APERCU_MAX:
        borne = APERCU_MAX
    dom_text(dom_get("lsystem-string-preview"), seq[0:borne])

    # ---------- tortue : déléguée à tortue_lsysteme (params chaîne) ----------
    retour tortue_lsysteme(axiome, regles, generations, angle_deg)
