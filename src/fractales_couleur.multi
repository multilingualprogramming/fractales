# Rampes de couleur (interpolation RGB) pour les ateliers Croissance et Relief.
#
# L'interpolation de couleur est une primitive mathématique : conformément à
# l'identité du projet, elle vit ici en multilingue compilé vers WASM, et non
# plus recopiée à la main dans le JS de chaque studio (renderer-process.js et
# renderer-relief.js portaient chacun leur propre lerp RGB sur des arrêts).
#
# Chaque routine prend t∈[0,1] et renvoie le triplet (r, g, b) en octets. Le
# mélange reproduit exactement le `Math.round(a + (b - a) * f)` du JS : pour des
# canaux toujours positifs (0..255), `trunc(x + 0.5)` est bit-à-bit identique à
# l'arrondi JS au demi supérieur, donc la parité avec le repli JS est exacte.

# Borne t dans l'unité [0, 1] (même clamp que Math.max(0, Math.min(1, t))).
déf borner_unite(t):
    soit u = t
    si u < 0.0:
        u = 0.0
    si u > 1.0:
        u = 1.0
    retour u

# Mélange un canal entre a et b à la fraction f, arrondi à l'octet le plus proche.
déf melanger_canal(a, b, f):
    retour math.trunc(a + (b - a) * f + 0.5)

# Rampe thermique à 5 arrêts (bleu nuit -> cyan -> vert -> jaune -> rouge) de
# l'atelier Croissance. Miroir de ARRETS_THERMIQUE dans renderer-process.js.
déf couleur_thermique(t):
    soit u = borner_unite(t)
    soit pos = u * 4.0
    soit i = math.trunc(pos)
    si i > 3.0:
        i = 3.0
    soit f = pos - i
    si i < 1.0:
        retour (melanger_canal(12.0, 22.0, f), melanger_canal(16.0, 138.0, f), melanger_canal(48.0, 173.0, f))
    si i < 2.0:
        retour (melanger_canal(22.0, 120.0, f), melanger_canal(138.0, 200.0, f), melanger_canal(173.0, 90.0, f))
    si i < 3.0:
        retour (melanger_canal(120.0, 245.0, f), melanger_canal(200.0, 215.0, f), melanger_canal(90.0, 66.0, f))
    retour (melanger_canal(245.0, 222.0, f), melanger_canal(215.0, 60.0, f), melanger_canal(66.0, 75.0, f))

# Rampe topographique à 4 arrêts (bleu profond -> turquoise -> vert -> ambre) de
# l'atelier Relief 3D. Miroir des arrêts dans couleurRelief (renderer-relief.js).
déf couleur_relief(t):
    soit u = borner_unite(t)
    soit pos = u * 3.0
    soit i = math.trunc(pos)
    si i > 2.0:
        i = 2.0
    soit f = pos - i
    si i < 1.0:
        retour (melanger_canal(18.0, 30.0, f), melanger_canal(24.0, 132.0, f), melanger_canal(64.0, 160.0, f))
    si i < 2.0:
        retour (melanger_canal(30.0, 120.0, f), melanger_canal(132.0, 198.0, f), melanger_canal(160.0, 150.0, f))
    retour (melanger_canal(120.0, 240.0, f), melanger_canal(198.0, 206.0, f), melanger_canal(150.0, 110.0, f))

# Coloration des fractales à temps d'échappement (le chemin chaud du canevas
# principal). Miroir EXACT de getColorFromRatio (renderer.js) : c'est la primitive
# d'interpolation centrale du démonstrateur, désormais en multilingue.
#
# `stops` est la liste plate des arrêts de palette [r0, g0, b0, r1, g1, b1, …]
# (octets 0..255) ; `n_stops` = nombre d'arrêts. `mode` est un code numérique :
#   0 = standard, 1 = histogramme, 2 = phase, 3 = potentiel, 4 = contours.
# `phase` ∈ [0,1) décale la rampe (mode phase) ; `contours` (0/1) force le
# striage des bandes (drapeau paletteContours, orthogonal au mode).
#
# Parité : standard / phase / contours sont bit-à-bit identiques au JS (clamp,
# soustractions, trunc(x+0.5)). histogramme (** 0.62) et potentiel (math.cos)
# emploient des transcendantes ⇒ parité à ±1 octet près (math.cos ~1e-6).
déf couleur_palette(t, stops, n_stops, mode, phase, contours):
    soit normalise = t
    si normalise < 0.0:
        normalise = 0.0
    si normalise > 0.999999:
        normalise = 0.999999
    si mode == 1.0:
        # histogramme : pow(normalise, 0.62). pow_f64 renvoie NaN pour base 0 ⇒
        # garde le cas normalise == 0 (où JS Math.pow(0, 0.62) vaut 0).
        si normalise > 0.0:
            normalise = normalise ** 0.62
    sinon si mode == 2.0:
        # phase : (normalise + phase) % 1.0 (les deux opérandes ≥ 0).
        soit somme = normalise + phase
        normalise = somme - math.trunc(somme)
    sinon si mode == 3.0:
        # potentiel : 0.5 - 0.5·cos(normalise·π).
        normalise = 0.5 - 0.5 * math.cos(normalise * math.pi)
    soit echelle = n_stops - 1.0
    soit scaled = normalise * echelle
    soit lo = math.trunc(scaled)
    soit hi = lo + 1.0
    si hi > echelle:
        hi = echelle
    soit frac = scaled - lo
    soit base_lo = lo * 3.0
    soit base_hi = hi * 3.0
    soit r = melanger_canal(stops[base_lo], stops[base_hi], frac)
    soit g = melanger_canal(stops[base_lo + 1.0], stops[base_hi + 1.0], frac)
    soit b = melanger_canal(stops[base_lo + 2.0], stops[base_hi + 2.0], frac)
    # Striage de contours (mode 4 ou drapeau) : assombrit puis éclaircit les
    # bandes — clampByte(value·0.58 + 255·0.22), within range donc trunc(x+0.5).
    soit appliquer_contour = 0.0
    si mode == 4.0:
        appliquer_contour = 1.0
    si contours > 0.5:
        appliquer_contour = 1.0
    si appliquer_contour > 0.5:
        soit x = normalise * 36.0
        soit bande = x - math.trunc(x) - 0.5
        si bande < 0.0:
            bande = -bande
        si bande > 0.42:
            r = math.trunc(r * 0.58 + 255.0 * 0.22 + 0.5)
            g = math.trunc(g * 0.58 + 255.0 * 0.22 + 0.5)
            b = math.trunc(b * 0.58 + 255.0 * 0.22 + 0.5)
    retour (r, g, b)

# Coloration par lot d'un champ de ratios : un seul aller-retour JS↔WASM par
# image. `ratios` est la liste plate des t par pixel ; un ratio < 0 signale un
# pixel captif (intérieur) ⇒ couleur (int_r, int_g, int_b). Renvoie la liste
# plate RGB [r0, g0, b0, …] de longueur 3·n.
déf colorer_champ(ratios, stops, int_r, int_g, int_b, mode, phase, contours):
    soit n = longueur(ratios)
    soit n_stops = longueur(stops) / 3.0
    soit sortie = [0.0] * (n * 3.0)
    soit i = 0.0
    tantque i < n:
        soit t = ratios[i]
        soit base = i * 3.0
        si t < 0.0:
            sortie[base] = int_r
            sortie[base + 1.0] = int_g
            sortie[base + 2.0] = int_b
        sinon:
            soit cr, cg, cb = couleur_palette(t, stops, n_stops, mode, phase, contours)
            sortie[base] = cr
            sortie[base + 1.0] = cg
            sortie[base + 2.0] = cb
        i = i + 1.0
    retour sortie
