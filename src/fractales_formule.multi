# Arithmétique complexe et formules d'itération personnalisées
#
# Chaque nombre complexe z = x + iy est représenté par deux flottants (re, im).
# Ces primitives sont utilisées par les preréglages compilés en WASM.
# Les formules définies par l'utilisateur sont évaluées côté JS via compilerFormule().

# ---------- Normalisation d'angle (pour sin/cos) ----------

déf normaliser_angle_formule(a):
    tantque a > 3.141592653589793:
        a = a - 6.283185307179586
    tantque a < -3.141592653589793:
        a = a + 6.283185307179586
    retour a

# ---------- Fonctions trigonométriques réelles (séries de Taylor) ----------

déf sinus_formule(a):
    soit x = normaliser_angle_formule(a)
    soit x2 = x * x
    retour x * (1.0 - x2 / 6.0 * (1.0 - x2 / 20.0 * (1.0 - x2 / 42.0)))

déf cosinus_formule(a):
    soit x = normaliser_angle_formule(a)
    soit x2 = x * x
    retour 1.0 - x2 / 2.0 * (1.0 - x2 / 12.0 * (1.0 - x2 / 30.0))

# ---------- Arithmétique complexe (partie réelle et imaginaire séparées) ----------

déf formule_add_re(ax, ay, bx, by):
    retour ax + bx

déf formule_add_im(ax, ay, bx, by):
    retour ay + by

déf formule_sub_re(ax, ay, bx, by):
    retour ax - bx

déf formule_sub_im(ax, ay, bx, by):
    retour ay - by

déf formule_mul_re(ax, ay, bx, by):
    retour ax * bx - ay * by

déf formule_mul_im(ax, ay, bx, by):
    retour ax * by + ay * bx

déf formule_div_re(ax, ay, bx, by):
    soit d = bx * bx + by * by
    si d < 1e-30:
        retour 0.0
    retour (ax * bx + ay * by) / d

déf formule_div_im(ax, ay, bx, by):
    soit d = bx * bx + by * by
    si d < 1e-30:
        retour 0.0
    retour (ay * bx - ax * by) / d

# ---------- Puissance complexe entière z^n ----------

déf formule_pow_re(x, y, n):
    soit r = 1.0
    soit m = 0.0
    soit k = 0.0
    tantque k < n:
        soit t = r * x - m * y
        m = r * y + m * x
        r = t
        k = k + 1.0
    retour r

déf formule_pow_im(x, y, n):
    soit r = 1.0
    soit m = 0.0
    soit k = 0.0
    tantque k < n:
        soit t = r * x - m * y
        m = r * y + m * x
        r = t
        k = k + 1.0
    retour m

# ---------- Module (valeur absolue complexe) ----------

déf formule_abs_re(x, y):
    soit r2 = x * x + y * y
    soit r = r2
    # Approximation de sqrt par méthode de Newton (3 itérations)
    si r > 0.0:
        soit g = r2 / 2.0 + 0.5
        g = (g + r2 / g) / 2.0
        g = (g + r2 / g) / 2.0
        r = (g + r2 / g) / 2.0
    retour r

déf formule_norme(x, y):
    retour x * x + y * y

déf formule_conj_re(x, y):
    retour x

déf formule_conj_im(x, y):
    retour -y

déf formule_exp_re(x, y):
    soit ex = 2.718281828459045 ^ x
    retour ex * cosinus_formule(y)

déf formule_exp_im(x, y):
    soit ex = 2.718281828459045 ^ x
    retour ex * sinus_formule(y)

déf log_formule(x):
    si x <= 0.0:
        retour -69.0
    soit k = 0.0
    soit y = x
    tantque y > 2.0:
        y = y / 2.0
        k = k + 1.0
    tantque y < 1.0:
        y = y * 2.0
        k = k - 1.0
    soit u = (y - 1.0) / (y + 1.0)
    soit u2 = u * u
    soit serie = u * (1.0 + u2 / 3.0 + (u2 * u2) / 5.0 + (u2 * u2 * u2) / 7.0)
    retour 2.0 * serie + k * 0.6931471805599453

déf formule_log_re(x, y):
    retour log_formule(formule_abs_re(x, y))

déf formule_arg(x, y):
    si x == 0.0:
        si y > 0.0:
            retour 1.5707963267948966
        si y < 0.0:
            retour -1.5707963267948966
        retour 0.0
    soit r = y / x
    soit r2 = r * r
    soit a = r * (1.0 - r2 / 3.0 + (r2 * r2) / 5.0)
    si x < 0.0:
        si y >= 0.0:
            a = a + 3.141592653589793
        sinon:
            a = a - 3.141592653589793
    retour a

déf formule_log_im(x, y):
    retour formule_arg(x, y)

# ---------- Sinus complexe : sin(x+iy) = sin(x)cosh(y) + i·cos(x)sinh(y) ----------

déf formule_sin_re(x, y):
    soit ey = 2.718281828459045 ^ y
    soit cosh_y = (ey + 1.0 / ey) / 2.0
    retour sinus_formule(x) * cosh_y

déf formule_sin_im(x, y):
    soit ey = 2.718281828459045 ^ y
    soit sinh_y = (ey - 1.0 / ey) / 2.0
    retour cosinus_formule(x) * sinh_y

# ---------- Cosinus complexe : cos(x+iy) = cos(x)cosh(y) - i·sin(x)sinh(y) ----------

déf formule_cos_re(x, y):
    soit ey = 2.718281828459045 ^ y
    soit cosh_y = (ey + 1.0 / ey) / 2.0
    retour cosinus_formule(x) * cosh_y

déf formule_cos_im(x, y):
    soit ey = 2.718281828459045 ^ y
    soit sinh_y = (ey - 1.0 / ey) / 2.0
    retour -sinus_formule(x) * sinh_y

déf formule_tan_re(x, y):
    soit sr = formule_sin_re(x, y)
    soit sim = formule_sin_im(x, y)
    soit cr = formule_cos_re(x, y)
    soit ci = formule_cos_im(x, y)
    retour formule_div_re(sr, sim, cr, ci)

déf formule_tan_im(x, y):
    soit sr = formule_sin_re(x, y)
    soit sim = formule_sin_im(x, y)
    soit cr = formule_cos_re(x, y)
    soit ci = formule_cos_im(x, y)
    retour formule_div_im(sr, sim, cr, ci)

# ---------- Preréglages compilés en WASM ----------
# Ces fonctions correspondent aux preréglages de l'Atelier formule.
# Pour les formules personnalisées, voir compilerFormule() dans renderer.js.

déf formule_z2c(cx, cy, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 4.0:
            retour iter
        soit xtemp = x * x - y * y + cx
        y = 2.0 * x * y + cy
        x = xtemp
        iter = iter + 1.0
    retour iter

déf formule_julia_z2c(zx, zy, cx, cy, max_iter):
    soit x = zx
    soit y = zy
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 4.0:
            retour iter
        soit xtemp = x * x - y * y + cx
        y = 2.0 * x * y + cy
        x = xtemp
        iter = iter + 1.0
    retour iter

déf formule_z3c(cx, cy, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 4.0:
            retour iter
        soit xtemp = formule_pow_re(x, y, 3.0) + cx
        y = formule_pow_im(x, y, 3.0) + cy
        x = xtemp
        iter = iter + 1.0
    retour iter

déf formule_sinc(cx, cy, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 4.0:
            retour iter
        soit xtemp = formule_sin_re(x, y) + cx
        y = formule_sin_im(x, y) + cy
        x = xtemp
        iter = iter + 1.0
    retour iter

déf formule_cosinus_c(cx, cy, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 16.0:
            retour iter
        soit xtemp = formule_cos_re(x, y) + cx
        y = formule_cos_im(x, y) + cy
        x = xtemp
        iter = iter + 1.0
    retour iter

déf formule_biomorphe(cx, cy, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 16.0:
            retour iter
        soit z2x = x * x - y * y
        soit z2y = 2.0 * x * y
        soit divx = formule_div_re(x, y, cx, cy)
        soit divy = formule_div_im(x, y, cx, cy)
        x = z2x + divx
        y = z2y + divy
        iter = iter + 1.0
    retour iter

déf formule_tricorne(cx, cy, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 4.0:
            retour iter
        soit conjx = formule_conj_re(x, y)
        soit conjy = formule_conj_im(x, y)
        soit xtemp = conjx * conjx - conjy * conjy + cx
        y = 2.0 * conjx * conjy + cy
        x = xtemp
        iter = iter + 1.0
    retour iter

déf formule_perturbee(cx, cy, a, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 9.0:
            retour iter
        soit xtemp = x * x - y * y + cx + a * formule_sin_re(x, y)
        y = 2.0 * x * y + cy + a * formule_sin_im(x, y)
        x = xtemp
        iter = iter + 1.0
    retour iter

déf formule_rationnelle(cx, cy, a, b, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 64.0:
            retour iter
        soit z2x = x * x - y * y
        soit z2y = 2.0 * x * y
        soit denx = z2x + b
        soit deny = z2y
        soit corrx = formule_div_re(a, 0.0, denx, deny)
        soit corry = formule_div_im(a, 0.0, denx, deny)
        x = z2x + cx + corrx
        y = z2y + cy + corry
        iter = iter + 1.0
    retour iter

déf formule_exponentielle(cx, cy, a, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 144.0:
            retour iter
        soit xtemp = formule_exp_re(x, y) + cx - a
        y = formule_exp_im(x, y) + cy
        x = xtemp
        iter = iter + 1.0
    retour iter

déf formule_tangente_c(cx, cy, a, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 64.0:
            retour iter
        soit xtemp = formule_tan_re(x, y) + cx * a
        y = formule_tan_im(x, y) + cy * a
        x = xtemp
        iter = iter + 1.0
    retour iter

déf formule_norme_perturbee(cx, cy, a, max_iter):
    soit x = 0.0
    soit y = 0.0
    soit iter = 0.0
    tantque iter < max_iter:
        si x * x + y * y > 36.0:
            retour iter
        soit n = formule_norme(x, y)
        soit xtemp = x * x - y * y + cx - a * n
        y = 2.0 * x * y + cy
        x = xtemp
        iter = iter + 1.0
    retour iter

# ---------- Variantes canoniques à paramètres fixes ----------
# L'Atelier formule garde les curseurs a/b côté interface, tandis que ces
# fonctions donnent au catalogue WASM des versions reproductibles.

déf formule_perturbee_canonique(cx, cy, max_iter):
    retour formule_perturbee(cx, cy, 0.25, max_iter)

déf formule_rationnelle_canonique(cx, cy, max_iter):
    retour formule_rationnelle(cx, cy, 0.2, 0.4, max_iter)

déf formule_exponentielle_canonique(cx, cy, max_iter):
    retour formule_exponentielle(cx, cy, 1.0, max_iter)

déf formule_tangente_canonique(cx, cy, max_iter):
    retour formule_tangente_c(cx, cy, 0.6, max_iter)

déf formule_norme_canonique(cx, cy, max_iter):
    retour formule_norme_perturbee(cx, cy, 0.08, max_iter)
