# Capture d'orbites — panneau « ☷ Météo mathématique » de l'Atelier
# d'exploration. Itère la suite et enregistre chaque point (au lieu de juste
# compter les itérations). Une orbite ≈ une trajectoire dans le plan complexe
# que l'utilisateur peut « rejouer » par-dessus le rendu.
#
# Sortie : liste plate de longueur 2 + 2*MAX_ORBITE :
#   sortie[0] = nombre de points enregistrés (np)
#   sortie[1] = drapeau d'échappement (1.0 si échappée, 0.0 sinon)
#   sortie[2 + 2k]     = x_k
#   sortie[3 + 2k]     = y_k
# (un seul aller-retour JS↔WASM par capture — le panneau anime ensuite à 4 pts/frame)
#
# Code de famille (mandelbrot et variantes) :
#   0 mandelbrot              | 8  heart
#   1 julia                   | 9  perpendicular_burning_ship
#   2 burning_ship            | 10 perpendicular_mandelbrot
#   3 burning_julia           | 11 duck
#   4 tricorn                 |
#   5 celtic                  | (newton et phoenix ont des entrées dédiées —
#   6 perpendicular_celtic    |  structures d'itération différentes)
#   7 buffalo                 |

déf abs_orbite(v):
    si v < 0.0:
        retour -v
    retour v

déf orbite_mandelbrot_famille(code, p_re, p_im, c_re_julia, c_im_julia, max_iter):
    # `code` détermine le variant ET d'où viennent (x0, y0, cx, cy) :
    #   julia/burning_julia (1, 3) : z démarre à (p_re, p_im), c = (c_re_julia, c_im_julia)
    #   autres                      : z démarre à (0, 0), c = (p_re, p_im)
    soit MAX_ORBITE = 320

    soit lim = max_iter
    si lim > MAX_ORBITE:
        lim = MAX_ORBITE
    si lim < 32:
        lim = 32

    soit sortie = [0.0] * (2 + 2 * MAX_ORBITE)

    # Initialisation z₀ et c selon la variante.
    soit est_julia = 0
    si code == 1:
        est_julia = 1
    si code == 3:
        est_julia = 1

    soit x = 0.0
    soit y = 0.0
    soit cx = p_re
    soit cy = p_im
    si est_julia == 1:
        x = p_re
        y = p_im
        cx = c_re_julia
        cy = c_im_julia

    # Drapeaux de variante.
    soit is_burning = 0       # codes 2 (burning_ship), 3 (burning_julia)
    soit is_buffalo = 0       # code 7
    soit is_celtic  = 0       # codes 5, 6
    soit is_heart   = 0       # code 8
    soit is_duck    = 0       # code 11
    soit is_tricorn = 0       # code 4
    soit is_perp_y  = 0       # codes 6, 9, 10
    si code == 2:
        is_burning = 1
    si code == 3:
        is_burning = 1
    si code == 7:
        is_buffalo = 1
    si code == 5:
        is_celtic = 1
    si code == 6:
        is_celtic = 1
    si code == 8:
        is_heart = 1
    si code == 11:
        is_duck = 1
    si code == 4:
        is_tricorn = 1
    si code == 6:
        is_perp_y = 1
    si code == 9:
        is_perp_y = 1
    si code == 10:
        is_perp_y = 1

    soit cx_eff = cx
    si is_duck == 1:
        cx_eff = abs_orbite(cx)

    soit np = 0
    soit escaped = 0.0
    soit i = 0
    tantque i < lim:
        # Enregistrer (x, y).
        sortie[2 + 2 * np] = x
        sortie[3 + 2 * np] = y
        np = np + 1

        # Préparation des arguments selon les variantes (|x|, |y|).
        soit ax = x
        si is_burning == 1:
            ax = abs_orbite(x)
        si is_buffalo == 1:
            ax = abs_orbite(x)
        soit ay = y
        si is_burning == 1:
            ay = abs_orbite(y)

        # Calcul de (nx, ny) selon la variante.
        soit nx = 0.0
        soit ny = 0.0
        soit variante = 0
        si is_celtic == 1:
            variante = 1
        si is_heart == 1:
            variante = 2
        si is_duck == 1:
            variante = 3
        si variante == 1:
            nx = abs_orbite(ax * ax - ay * ay) + cx
            ny = 2.0 * ax * ay + cy
        sinonsi variante == 2:
            nx = ax * ax - ay * ay + cx
            ny = abs_orbite(2.0 * ax * ay) + cy
        sinonsi variante == 3:
            nx = ax * ax - ay * ay + cx_eff
            ny = 2.0 * ax * ay + cy
        sinon:
            nx = ax * ax - ay * ay + cx
            ny = 2.0 * ax * ay + cy

        x = nx
        si is_tricorn == 1:
            y = -ny
        sinonsi is_perp_y == 1:
            y = abs_orbite(ny)
        sinon:
            y = ny

        si x * x + y * y > 16.0:
            escaped = 1.0
            i = lim
        sinon:
            i = i + 1

    sortie[0] = np
    sortie[1] = escaped
    retour sortie


déf orbite_newton(zx, zy, max_iter):
    # Newton-Raphson sur z³ − 1 : z ← (2z³ + 1) / (3z²). Arrête à la convergence
    # vers l'une des trois racines de l'unité.
    soit MAX_ORBITE = 320
    soit lim = max_iter
    si lim > MAX_ORBITE:
        lim = MAX_ORBITE
    si lim < 32:
        lim = 32

    soit sortie = [0.0] * (2 + 2 * MAX_ORBITE)

    soit x = zx
    soit y = zy
    soit np = 0
    soit escaped = 0.0
    soit done = 0

    # Racines de l'unité (z³ = 1) : 1, e^(2iπ/3), e^(-2iπ/3).
    soit r1x = 1.0
    soit r1y = 0.0
    soit r2x = -0.5
    soit r2y = 0.8660254037844386
    soit r3x = -0.5
    soit r3y = -0.8660254037844386

    soit i = 0
    tantque i < lim:
        sortie[2 + 2 * np] = x
        sortie[3 + 2 * np] = y
        np = np + 1

        si done == 0:
            soit x2 = x * x - y * y
            soit y2 = 2.0 * x * y
            soit x3 = x2 * x - y2 * y
            soit y3 = x2 * y + y2 * x
            soit num_re = 2.0 * x3 + 1.0
            soit num_im = 2.0 * y3
            soit den_re = 3.0 * x2
            soit den_im = 3.0 * y2
            soit den2 = den_re * den_re + den_im * den_im
            si den2 < 1.0e-14:
                done = 1
            sinon:
                x = (num_re * den_re + num_im * den_im) / den2
                y = (num_im * den_re - num_re * den_im) / den2
                # détection de divergence (NaN/inf via test relatif large)
                si abs_orbite(x) > 1.0e12:
                    escaped = 1.0
                    done = 1
                sinon:
                    si abs_orbite(y) > 1.0e12:
                        escaped = 1.0
                        done = 1
                    sinon:
                        # Arrêter à la convergence (<1e-4 d'une racine).
                        soit d1 = (x - r1x) * (x - r1x) + (y - r1y) * (y - r1y)
                        soit d2 = (x - r2x) * (x - r2x) + (y - r2y) * (y - r2y)
                        soit d3 = (x - r3x) * (x - r3x) + (y - r3y) * (y - r3y)
                        si d1 < 1.0e-8:
                            done = 1
                        si d2 < 1.0e-8:
                            done = 1
                        si d3 < 1.0e-8:
                            done = 1
        si done == 1:
            i = lim
        sinon:
            i = i + 1

    sortie[0] = np
    sortie[1] = escaped
    retour sortie


déf orbite_phoenix(zx, zy, c_re, c_im, max_iter):
    # Phoenix : z_{n+1} = z_n² + c + p·z_{n-1}, avec p = 0.5667 (réel).
    # Garde z_{n-1} dans (px, py). Arrête à |z|² > 16.
    soit MAX_ORBITE = 320
    soit lim = max_iter
    si lim > MAX_ORBITE:
        lim = MAX_ORBITE
    si lim < 32:
        lim = 32

    soit sortie = [0.0] * (2 + 2 * MAX_ORBITE)

    soit x = zx
    soit y = zy
    soit px = 0.0
    soit py = 0.0
    soit p_phoenix = 0.5667

    soit np = 0
    soit escaped = 0.0
    soit i = 0
    tantque i < lim:
        sortie[2 + 2 * np] = x
        sortie[3 + 2 * np] = y
        np = np + 1
        soit nx = x * x - y * y + c_re + p_phoenix * px
        soit ny = 2.0 * x * y + c_im + p_phoenix * py
        px = x
        py = y
        x = nx
        y = ny
        si x * x + y * y > 16.0:
            escaped = 1.0
            i = lim
        sinon:
            i = i + 1

    sortie[0] = np
    sortie[1] = escaped
    retour sortie
