# Transformations du plan — panneau « ◈ Transformations » de l'Atelier
# d'exploration. Math pure (complexe → complexe) appliquée par pixel avant
# l'appel des fractales d'évasion. Une routine par composante (x, y) pour
# éviter les retours tuple côté WAT (cf. attracteurs).
#
# Modes côté JS :
#   log_polaire       : z → ln|z| + i·arg(z)
#   inversion         : z → 1/z̄ = (x − iy)/|z|²  (et même math pour Möbius
#                       préréglé « inversion_cercle »)
#   pli_x / pli_y / pli_xy : valeurs absolues (réflexions)
#   mobius / cayley   : (z − 1)/(z + 1)
#   mobius / joukowski: (z + 1/z)/2

# Depuis multilingual B1 (multi-value returns) : chaque transforme renvoie le
# couple (x', y') directement, plus de duplication _x/_y. Le caller JS lit
# les deux valeurs via la signature (result f64 f64).

déf transforme_log_polaire(x, y):
    soit r2 = x * x + y * y
    si r2 < 1.0e-20:
        retour (x, y)
    retour (0.5 * math.log(r2), math.atan2(y, x))

déf transforme_inversion(x, y):
    soit r2 = x * x + y * y
    si r2 < 1.0e-20:
        retour (x, y)
    retour (x / r2, -y / r2)

déf transforme_pli_xy(x, y):
    soit ax = x
    soit ay = y
    si x < 0.0:
        ax = -x
    si y < 0.0:
        ay = -y
    retour (ax, ay)

déf transforme_cayley(x, y):
    soit den_re = x + 1.0
    soit den_im = y
    soit den2 = den_re * den_re + den_im * den_im
    si den2 < 1.0e-20:
        retour (x, y)
    retour (((x - 1.0) * den_re + y * den_im) / den2, (y * den_re - (x - 1.0) * den_im) / den2)

déf transforme_joukowski(x, y):
    soit r2 = x * x + y * y
    si r2 < 1.0e-20:
        retour (x, y)
    retour ((x + x / r2) * 0.5, (y - y / r2) * 0.5)
